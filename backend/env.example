# Backend environment template (NJ TRANSIT Rail Data API proxy)
#
# Copy to `backend/.env` and fill in values.
# Note: do NOT commit `backend/.env`.

# Server
PORT=8787
NODE_ENV=development

# CORS
# - For local dev, you can use a single origin:
CORS_ORIGIN=http://localhost:5173
# - For production, prefer an allowlist:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# NJ TRANSIT Rail Data API (Swagger)
# Test: https://testraildata.njtransit.com/swagger/index.html
# Prod: https://raildata.njtransit.com/swagger/index.html
NJT_ENV=test
NJT_USERNAME=
NJT_PASSWORD=

# Fetch behavior
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_MAX_RETRIES=1
VEHICLE_CACHE_TTL_MS=15000
USER_AGENT=nj-transit-realtime-map/1.0

# Abuse protection (backend)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Optional: require this header on /api/* requests: `x-api-key: <BACKEND_API_KEY>`
BACKEND_API_KEY=

# Token/state persistence (recommended to avoid daily getToken limits across restarts)
TOKEN_STATE_DIR=backend/.state

# Logging
LOG_LEVEL=info

