# Backend environment template (NJ TRANSIT Rail Data API proxy)
#
# Copy to `backend/.env` and fill in values.
# Note: do NOT commit `backend/.env`.

# Server
PORT=8787
NODE_ENV=development

# CORS (set to your frontend origin in production)
CORS_ORIGIN=http://localhost:5173

# NJ TRANSIT Rail Data API (Swagger)
# Test: https://testraildata.njtransit.com/swagger/index.html
# Prod: https://raildata.njtransit.com/swagger/index.html
NJT_ENV=test
NJT_USERNAME=
NJT_PASSWORD=

# Fetch behavior
UPSTREAM_TIMEOUT_MS=10000
VEHICLE_CACHE_TTL_MS=15000
USER_AGENT=nj-transit-realtime-map/1.0

# Logging
LOG_LEVEL=info

